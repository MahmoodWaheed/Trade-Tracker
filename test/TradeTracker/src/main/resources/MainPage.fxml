<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="825.0" stylesheets="@style/MainPage.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.MainController">
   <children>
      <HBox prefWidth="811.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox minWidth="200.0" prefWidth="200.0" styleClass="sidebar">
               <children>
                  <Label styleClass="sidebar-title" text="Baligo" />
                  <TextField promptText="Search" styleClass="sidebar-search" />
                  <Label styleClass="sidebar-section-title" text="Application" />
                  <Button fx:id="productDashButton" onAction="#handelProductManageButtonInDashboard" styleClass="sidebar-button" text="Products Management" />
                  <Button styleClass="sidebar-button" text="Timeline" />
                  <Button styleClass="sidebar-button" text="Users" />
                  <Button fx:id="employeeDashButton" mnemonicParsing="false" onAction="#handelEmployeeButtonInDashboard" styleClass="sidebar-button" text="Employees" />
                  <Label styleClass="sidebar-section-title" text="Others" />
                  <Button styleClass="sidebar-button" text="Activity" />
                  <Button styleClass="sidebar-button" text="Messages" />
                  <Button styleClass="sidebar-button" text="Settings" />
               </children>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
            </VBox>
            <ScrollPane HBox.hgrow="ALWAYS">
              <content>
                <AnchorPane fx:id="contentPlaceholder" minHeight="650.0" minWidth="1320.0" prefHeight="700.0" prefWidth="625.0" />
              </content>
            </ScrollPane>
         </children>
      </HBox>
   </children>

</AnchorPane>
